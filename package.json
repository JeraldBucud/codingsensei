{
  "name": "codingsensei",
  "displayName": "CodingSensei",
  "description": "A local-first VS Code learning companion that helps you learn to code by coding.",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "publisher": "codingsensei-local",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "learning",
    "education",
    "local-first",
    "hints",
    "programming"
  ],
  "icon": "assets/brand/icons/codingsensei-app-icon.png",
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "resources",
    "assets/brand/icons/codingsensei-app-icon.png",
    "README.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onView:codingsensei.learningMode",
    "onCommand:codingsensei.openLearningMode",
    "onCommand:codingsensei.refreshLearningContext",
    "onCommand:codingsensei.showNextHint",
    "onCommand:codingsensei.resetHints",
    "onCommand:codingsensei.showProjectIntelligence",
    "onCommand:codingsensei.rebuildProjectIntelligence",
    "onCommand:codingsensei.clearProjectIntelligence"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codingsensei.openLearningMode",
        "title": "CodingSensei: Open Learning Mode",
        "category": "CodingSensei"
      },
      {
        "command": "codingsensei.refreshLearningContext",
        "title": "CodingSensei: Refresh Learning Context",
        "category": "CodingSensei",
        "icon": "$(refresh)"
      },
      {
        "command": "codingsensei.showNextHint",
        "title": "CodingSensei: Show Next Hint",
        "category": "CodingSensei",
        "icon": "$(lightbulb)"
      },
      {
        "command": "codingsensei.resetHints",
        "title": "CodingSensei: Reset Hints",
        "category": "CodingSensei",
        "icon": "$(discard)"
      },
      {
        "command": "codingsensei.showProjectIntelligence",
        "title": "CodingSensei: Show Project Intelligence",
        "category": "CodingSensei"
      },
      {
        "command": "codingsensei.rebuildProjectIntelligence",
        "title": "CodingSensei: Rebuild Project Intelligence",
        "category": "CodingSensei"
      },
      {
        "command": "codingsensei.clearProjectIntelligence",
        "title": "CodingSensei: Clear Stored Project Intelligence",
        "category": "CodingSensei"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codingsensei",
          "title": "CodingSensei",
          "icon": "resources/codingsensei.svg"
        }
      ]
    },
    "views": {
      "codingsensei": [
        {
          "id": "codingsensei.learningMode",
          "name": "Learning Mode",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codingsensei.refreshLearningContext",
          "when": "view == codingsensei.learningMode",
          "group": "navigation@1"
        },
        {
          "command": "codingsensei.showNextHint",
          "when": "view == codingsensei.learningMode",
          "group": "navigation@2"
        },
        {
          "command": "codingsensei.resetHints",
          "when": "view == codingsensei.learningMode",
          "group": "secondary@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm typecheck && node esbuild.mjs",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "dev": "node esbuild.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "1.92.0",
    "@eslint/js": "^9.9.1",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@11.19.0"
}
